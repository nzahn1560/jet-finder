# Jet Finder environment variables.
# Copy to `.env` for local dev. In production, set these in Railway → Variables.
# Never commit a real `.env` file (the .gitignore already excludes it).

# -------- App / runtime --------
FLASK_ENV=production            # use 'development' locally
SECRET_KEY=change-me-in-prod    # Flask session signing

# -------- Database (PostgreSQL on Railway, SQLite locally) --------
# DATABASE_URL is set automatically by Railway when Postgres is attached.
# DATABASE_URL=postgresql://user:password@host:port/dbname

# -------- Cloudflare R2 (listing photos/videos) --------
# All 4 are REQUIRED in production. Without them, uploads will be rejected.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=jetschool-media

# Optional. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# The URL the browser uses to fetch media. Use a custom Cloudflare-proxied
# subdomain so media is cached globally (e.g. media.jetschoolusa.com).
R2_PUBLIC_BASE_URL=https://media.jetschoolusa.com

# -------- Stripe (optional, only if you use Stripe billing) --------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# -------- Safety override (NEVER set in normal deploys) --------
# Only set this temporarily during planned recovery ops (see BACKUPS.md).
# ALLOW_DESTRUCTIVE_DB_OPS=yes_i_understand
